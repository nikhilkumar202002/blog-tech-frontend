# ----------------------------------------------------------------------
# GZIP / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# ----------------------------------------------------------------------
# Cache-Control & Expires Headers
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents (short cache for fresh content)
  ExpiresByType text/html "access plus 0 seconds"

  # Next.js static immutable assets (hashed JS & CSS)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Media & Fonts
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Immutable long-term cache for Next static chunks
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|ico|svg|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages should revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Rewrite Engine & Clean URL Handling
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable directory listing and MultiViews
  Options -Indexes -MultiViews
  DirectoryIndex index.html

  # 1. ALWAYS serve existing physical files directly (JS, CSS, images, .txt, .json, .html)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Serve directory directly if index.html exists inside it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 3. Handle clean URLs for folder/index.html (e.g. /about-us or /about-us/ -> /about-us/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L,QSA]

  # 4. Fallback to 404 page for missing resources
  ErrorDocument 404 /404.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>

