# ----------------------------------------------------------------------
# GZIP / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# ----------------------------------------------------------------------
# Correct MIME Types for Media & Static Assets
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# ----------------------------------------------------------------------
# Cache-Control & Expires Headers
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents (revalidate to ensure fresh page navigation)
  ExpiresByType text/html "access plus 0 seconds"

  # Immutable static assets (hashed JS, CSS, images, video)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long-term cache for immutable assets
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|ico|svg|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML revalidation
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Rewrite Engine & Navigation Routing for Next.js Export (cPanel / HostingSpell)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable directory listing and MultiViews
  Options -Indexes -MultiViews
  DirectoryIndex index.html

  # 1. Standardize root request / -> index.html
  RewriteRule ^$ index.html [L]

  # 2. Always serve existing physical files & directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Clean URLs for directories containing index.html (e.g. /contact-us or /contact-us/ -> /contact-us/index.html)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 4. Clean URLs for .html files (e.g. /contact-us -> /contact-us.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 5. SPA Fallback: Route non-file requests to /index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [L]

  # 6. Error document fallback
  ErrorDocument 404 /404.html
</IfModule>



